# Copy this file to .env and fill in your keys. .env is gitignored.

# Fal.ai API key. Get one at https://fal.ai/dashboard/keys
# Used by .claude/skills/fal-image-gen/ for image and video generation.
FAL_KEY=

# Meta Graph API. See references/resources/resources-meta-api-setup.md
# Used by data-sync/meta_sync.py to pull ad spend, ROAS, clicks.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
